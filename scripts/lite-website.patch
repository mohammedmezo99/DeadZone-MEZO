           final_zip="${final_zips[0]}"
           final_name="$(basename "$final_zip")"
+
+          if ! python3 -m zipfile -t "$final_zip" >/dev/null; then
+            echo "::error::Final Lite ZIP failed archive integrity validation: ${final_name}"
+            sudo rm -rf "$PWD/out" "$PWD/build"
+            exit 1
+          fi
+          final_size_bytes="$(stat -c '%s' "$final_zip")"
+          final_size_human="$(python3 - "$final_size_bytes" <<'PY'
+          import sys
+          size = int(sys.argv[1])
+          value = float(size)
+          for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
+              if value < 1024 or unit == "TiB":
+                  print(f"{size} B" if unit == "B" else f"{value:.2f} {unit}")
+                  break
+              value /= 1024
+          PY
+          )"
+          printf 'DEADZONE_FILE_SIZE=%s\nDEADZONE_INTEGRITY_VERIFIED=1\n' "$final_size_human" >> "$GITHUB_ENV"
           codename="$(tr '[:lower:]' '[:upper:]' < "$PWD/bin/ddevice/device_f.txt" | sed 's/ /_/g' | tr -cd 'A-Za-z0-9._+-')"
           rom_version="$(tr -d '\r\n' < "$PWD/bin/ddevice/base_rom_code.txt")"
           if [[ "$rom_version" =~ ^(OS[0-9]+) ]]; then
@@ -379,6 +398,132 @@
             echo "::warning::Lite success live event failed; keeping successful ROM build"
           fi
 
+      - name: 🌐 Publish Lite release to website
+        if: success()
+        continue-on-error: true
+        working-directory: toolbuild
+        env:
+          GH_TOKEN: ${{ secrets.GH_TOKEN }}
+        run: |
+          set -Eeuo pipefail
+          if [[ -z "${DEADZONE_GOOGLE_DRIVE_URL:-}" || "${DEADZONE_INTEGRITY_VERIFIED:-0}" != "1" || -z "${DEADZONE_FILE_SIZE:-}" ]]; then
+            echo "::warning::Website release skipped because Google Drive or ZIP verification metadata is unavailable"
+            exit 0
+          fi
+          command -v gh >/dev/null 2>&1 || {
+            echo "::warning::gh CLI is unavailable; website release skipped"
+            exit 0
+          }
+
+          endpoint="/repos/mohammedmezo99/Deadzone/contents/src/data/published-builds.json"
+          catalog="$RUNNER_TEMP/deadzone-published-builds.json"
+          updater="$RUNNER_TEMP/deadzone-update-catalog.py"
+
+          cat > "$updater" <<'PY'
+          import json
+          import os
+          import re
+          import sys
+          from datetime import datetime, timezone
+          from pathlib import Path
+          from urllib.parse import urlparse
+
+          def env(name):
+              value = os.environ.get(name, "").strip()
+              if not value:
+                  raise SystemExit(f"Missing website release value: {name}")
+              return value
+
+          def text(path):
+              value = Path(path).read_text(encoding="utf-8", errors="replace").strip()
+              if not value:
+                  raise SystemExit(f"Missing website release metadata: {path}")
+              return value
+
+          path = Path(sys.argv[1])
+          catalog = json.loads(path.read_text(encoding="utf-8"))
+          if not isinstance(catalog, list) or any(not isinstance(entry, dict) for entry in catalog):
+              raise SystemExit("Website release catalog must be a JSON array of objects")
+
+          codename = text("bin/ddevice/device_f.txt").lower()
+          filename = env("DEADZONE_RESULT_NAME")
+          drive_url = env("DEADZONE_GOOGLE_DRIVE_URL")
+          parsed = urlparse(drive_url)
+          if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{1,39}", codename):
+              raise SystemExit("Invalid website release codename")
+          if not filename.lower().endswith(".zip") or "/" in filename or "\\" in filename:
+              raise SystemExit("Invalid website release filename")
+          if parsed.scheme != "https" or parsed.hostname != "drive.google.com" or parsed.username or parsed.password:
+              raise SystemExit("Website release requires a safe Google Drive URL")
+
+          release = {
+              "id": env("DEADZONE_REQUEST_ID"),
+              "project": "lite",
+              "edition": "Lite",
+              "editionVersion": text("Version"),
+              "codename": codename,
+              "romVersion": text("bin/ddevice/base_rom_code.txt"),
+              "androidVersion": text("bin/ddevice/androidver.txt"),
+              "region": text("bin/ddevice/device_type.txt"),
+              "fileSize": env("DEADZONE_FILE_SIZE"),
+              "filename": filename,
+              "downloadUrl": drive_url,
+              "integrityVerified": True,
+              "updatedAt": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
+              "style": "Lite",
+              "status": "Available",
+          }
+
+          def same(entry):
+              return entry.get("id") == release["id"] or (
+                  str(entry.get("codename", "")).lower(),
+                  entry.get("edition") or entry.get("style"),
+                  str(entry.get("filename", "")).lower(),
+              ) == (
+                  release["codename"],
+                  release["edition"],
+                  release["filename"].lower(),
+              )
+
+          path.write_text(
+              json.dumps([release, *(entry for entry in catalog if not same(entry))], indent=2) + "\n",
+              encoding="utf-8",
+          )
+          PY
+
+          for attempt in 1 2 3 4; do
+            response="$(gh api "${endpoint}?ref=main")"
+            sha="$(jq -r '.sha' <<< "$response")"
+            jq -r '.content' <<< "$response" | tr -d '\n' | base64 -d > "$catalog"
+            python3 "$updater" "$catalog"
+            encoded="$(base64 -w0 "$catalog")"
+            codename="$(tr '[:upper:]' '[:lower:]' < bin/ddevice/device_f.txt | tr -d '\r\n')"
+
+            set +e
+            gh_output="$(gh api --method PUT "$endpoint" \
+              -f message="release: publish Lite ${codename} ${DEADZONE_RESULT_NAME}" \
+              -f content="$encoded" \
+              -f sha="$sha" \
+              -f branch=main 2>&1)"
+            gh_status=$?
+            set -e
+
+            if (( gh_status == 0 )); then
+              echo "Website release catalog published successfully"
+              exit 0
+            fi
+            if [[ "$gh_output" != *"HTTP 409"* && "$gh_output" != *"HTTP 422"* ]]; then
+              echo "::error::Website release catalog update failed"
+              printf '%s\n' "$gh_output"
+              exit 1
+            fi
+            echo "::warning::Website catalog changed concurrently; retrying (${attempt}/4)"
+            sleep "$attempt"
+          done
+
+          echo "::error::Website release catalog could not be published after retries"
+          exit 1
+
       - name: ❌ Send failure notification
         if: failure()
         shell: bash
